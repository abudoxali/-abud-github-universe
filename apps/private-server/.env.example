# Owner-only secure backend; DO NOT commit real values.
NODE_ENV=production
PORT=3164
HOST=127.0.0.1
PUBLIC_ORIGIN=https://os.abud.fun
DATABASE_URL=postgresql://owner:use_secure_password@127.0.0.1:5432/abud_os
GITHUB_CLIENT_ID=SET_FROM_GITHUB_OAUTH_APP
GITHUB_CLIENT_SECRET=SET_ON_SERVER_ONLY
GITHUB_OWNER_ID=SET_NUMERIC_GITHUB_ACCOUNT_ID
GITHUB_OWNER_LOGIN=abudoxali
GITHUB_APP_ID=SET_FROM_READ_ONLY_GITHUB_APP
GITHUB_INSTALLATION_ID=SET_SELECTED_REPO_INSTALLATION_ID
GITHUB_APP_PRIVATE_KEY_PATH=/etc/abud-os/github-app.pem
